// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Inscripcion {
  id          Int      @id @default(autoincrement())

  nombre      String
  dni         String
  nacimiento  String

  email       String
  telefono    String

  sede      String
  plan      String

  monto       Float

  estado      String   @default("pendiente")

  paymentId   String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  paidAt      DateTime?
}